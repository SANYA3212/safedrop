# SafeDrop для Arch Linux из исходников (ветка linux на GitHub). Сборка: makepkg -si
# Звонкам нужен WebKit с WebRTC: сначала собери ../webkit2gtk-4.1-webrtc.
pkgname=safedrop
pkgver=0.3.31
pkgrel=1
pkgdesc="SafeDrop — P2P обмен файлами, чаты и звонки по локальной сети и Radmin VPN"
arch=('x86_64')
url="https://github.com/SANYA3212/safedrop"
license=('LicenseRef-MIT-CommonsClause')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'gst-plugins-base' 'gst-plugins-good')
makedepends=('git' 'rust')
optdepends=(
  'webkit2gtk-4.1-webrtc: звонки и демонстрация экрана (обычный webkit2gtk-4.1 собран без WebRTC)'
  'gst-plugins-bad: звонки и демонстрация экрана (WebRTC)'
  'gst-libav: видео в «Смотреть вместе»'
  'gst-plugin-rsaudiofx: шумоподавление микрофона в звонках'
  'zip: отправка папок'
)
provides=('safedrop')
conflicts=('safedrop-bin')
options=('!lto')
source=("$pkgname::git+$url.git#tag=v$pkgver-untested")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname/src-tauri"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname/src-tauri"
  export CARGO_TARGET_DIR=target
  # фича custom-protocol (по умолчанию) вшивает интерфейс в бинарник
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 src-tauri/target/release/safedrop "$pkgdir/usr/bin/safedrop"
  # Tauri ищет ресурсы программы из /usr/bin в /usr/lib/<productName>
  install -d "$pkgdir/usr/lib/SafeDrop/icons"
  install -m644 src/icons/* "$pkgdir/usr/lib/SafeDrop/icons/"
  install -m644 src/logo.png "$pkgdir/usr/lib/SafeDrop/logo.png"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/safedrop.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/safedrop.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/safedrop.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/safedrop.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=SafeDrop
Comment=P2P обмен файлами, чаты и звонки
Exec=safedrop
Icon=safedrop
StartupWMClass=safedrop
Categories=Network;FileTransfer;Chat;
Terminal=false
EOF
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
