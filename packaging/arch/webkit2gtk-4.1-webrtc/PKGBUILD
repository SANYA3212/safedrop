# WebKitGTK 4.1 с включённым WebRTC — без него в SafeDrop на Linux не работают звонки
# и демонстрация экрана. Основан на PKGBUILD Arch (webkit2gtk-4.1 2.54.2-1, heftig):
# отличаются только -D ENABLE_WEB_RTC/USE_GSTREAMER_WEBRTC, нет документации и MiniBrowser.
# Подменяет системный webkit2gtk-4.1. Сборка долгая (1–3 часа):
#   makepkg -si
pkgname=webkit2gtk-4.1-webrtc
pkgver=2.54.2
pkgrel=1
pkgdesc="Web content engine for GTK (with WebRTC enabled)"
url="https://webkitgtk.org"
arch=(x86_64)
license=('LGPL-2.1-or-later' 'BSD-2-Clause')
depends=(
  at-spi2-core atk bubblewrap cairo enchant expat fontconfig freetype2 gdk-pixbuf2
  glib2 glibc gst-plugins-bad gst-plugins-bad-libs gst-plugins-base-libs gst-plugins-good
  gstreamer gtk3 harfbuzz harfbuzz-icu hyphen icu lcms2 libatomic libavif libdrm libegl
  libepoxy libgcc libgcrypt libgl libgles libjpeg-turbo libjxl libmanette libnice libpng
  libseccomp libsecret libsoup3 libstdc++ libsystemd libtasn1 libwebp libx11 libxml2
  libxslt mesa openjpeg2 openssl pango sqlite ttf-font wayland woff2 xdg-dbus-proxy zlib
)
makedepends=(
  clang cmake glib2-devel gobject-introspection gperf lld ninja python ruby
  ruby-stdlib systemd unifdef wayland-protocols
)
optdepends=(
  'gst-libav: nonfree media decoding'
)
provides=(
  "webkit2gtk-4.1=$pkgver"
  libjavascriptcoregtk-4.1.so
  libwebkit2gtk-4.1.so
)
conflicts=(webkit2gtk-4.1)
source=(
  $url/releases/webkitgtk-$pkgver.tar.xz{,.asc}
)
sha256sums=('a76345b391bef6211fb5ab6cfab2e86b285d18cda17cbb9ade595f1252b86065'
            'SKIP')
validpgpkeys=(
  # https://www.webkitgtk.org/verifying.html
  5AA3BC334FD7E3369E7C77B291C559DBE4C9123B # Adrián Pérez de Castro <aperez@igalia.com>
  013A0127AC9C65B34FFA62526C1009B693975393 # Carlos Garcia Campos <cgarcia@igalia.com>
)

build() {
  local cmake_options=(
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_LIBDIR=lib
    -D CMAKE_INSTALL_LIBEXECDIR=lib
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_SKIP_RPATH=ON
    -D ENABLE_DOCUMENTATION=OFF
    -D ENABLE_MINIBROWSER=OFF
    -D ENABLE_SPEECH_SYNTHESIS=OFF
    -D ENABLE_WEB_RTC=ON
    -D USE_GSTREAMER_WEBRTC=ON
    -D USE_LIBRICE=OFF
    -D PORT=GTK
    -D USE_FLITE=OFF
    -D USE_GTK4=OFF
    -D USE_LIBBACKTRACE=OFF
    -D USE_SOUP2=OFF
  )

  # Upstream prefers Clang
  export CC=clang CXX=clang++
  LDFLAGS+=" -fuse-ld=lld"

  # Skia uses malloc_usable_size
  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  # JITted code crashes when CET is used
  CFLAGS+=' -fcf-protection=none'
  CXXFLAGS+=' -fcf-protection=none'

  cmake -S webkitgtk-$pkgver -B build -G Ninja "${cmake_options[@]}"
  # ~1.5 ГБ памяти на поток: ограничь, если сборка падает по памяти (WEBKIT_JOBS=4 makepkg)
  cmake --build build -j "${WEBKIT_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -rf "$pkgdir/usr/bin" "$pkgdir/usr/share/doc"
  install -Dm644 webkitgtk-$pkgver/Source/WebCore/LICENSE-LGPL-2.1 \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-LGPL-2.1"
}
