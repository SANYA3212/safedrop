{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SafeDrop",
  "version": "0.3.27",
  "identifier": "com.safedrop.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [      {
        "title": "SafeDrop",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../src/icons/*": "icons/",
      "../src/logo.png": "logo.png",
      "../src-shell/target/release/safedrop_shell.dll": "shell/safedrop-shell-0.3.27.dll"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}

